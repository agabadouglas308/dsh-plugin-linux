{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek-Harness",
  "version": "0.1.0",
  "identifier": "ai.deepseek.harness.linux",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": null
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["rpm", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png"],
    "category": "Development",
    "shortDescription": "DeepSeek Harness desktop client for Linux",
    "longDescription": "Native Linux desktop wrapper for DeepSeek Harness. Manages the local dsh backend, provides a system tray, global shortcuts, and native D-Bus notifications.",
    "publisher": "DeepSeek Harness Community",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libnotify4"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libayatana-appindicator-gtk3",
          "libnotify"
        ]
      },
      "appimage": {
        
      }
    }
  }
}