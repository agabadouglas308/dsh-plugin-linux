{
  "name": "@deepseek-ai/dsh-plugin-linux-system",
  "description": "Native Linux system capabilities for DeepSeek Harness: systemd, journalctl, clipboard, containers",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.mts",
      "default": "./lib/index.mjs"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.mjs", "lib/index.d.mts", "cordis.patch.yml", "src"],
  "keywords": ["dsh-plugin", "cordis-plugin", "linux", "systemd", "journalctl", "wayland", "clipboard", "podman"],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@types/node": "^24.0.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2"
  }
}
